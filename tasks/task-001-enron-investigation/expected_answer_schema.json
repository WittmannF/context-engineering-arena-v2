{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task 001 Answer Schema",
  "description": "JSON Schema for valid submissions to task-001-enron-investigation",
  "type": "object",
  "required": [
    "task_id",
    "participant_id",
    "title",
    "executive_summary",
    "sections",
    "claims",
    "evidence",
    "timeline",
    "entities",
    "limitations"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "const": "task-001-enron-investigation",
      "description": "Must be exactly 'task-001-enron-investigation'"
    },
    "participant_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for the submitting participant or baseline"
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "description": "Title of the investigative brief"
    },
    "executive_summary": {
      "type": "string",
      "minLength": 200,
      "description": "Non-empty executive summary. Must be at least 200 characters."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "description": "Array of required sections. Must include all required section IDs.",
      "items": {
        "type": "object",
        "required": ["id", "title", "content"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Section identifier"
          },
          "title": {
            "type": "string",
            "description": "Human-readable section title"
          },
          "content": {
            "type": "string",
            "minLength": 50,
            "description": "Section content. Must not be empty or placeholder text."
          }
        }
      },
      "contains": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "const": "executive-summary"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 5,
      "description": "At least 5 claims. Each claim must have a type and confidence.",
      "items": {
        "type": "object",
        "required": ["id", "type", "claim", "confidence"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique claim identifier, e.g. 'claim-001'"
          },
          "type": {
            "type": "string",
            "enum": ["fact", "interpretation", "uncertainty"],
            "description": "Must be fact, interpretation, or uncertainty"
          },
          "claim": {
            "type": "string",
            "minLength": 20,
            "description": "The claim text"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Confidence score between 0.0 and 1.0"
          },
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string"},
            "description": "References to evidence items supporting this claim"
          },
          "topic": {
            "type": "string",
            "description": "Topic cluster this claim belongs to"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "description": "At least 3 evidence items. Each must reference a specific email.",
      "items": {
        "type": "object",
        "required": ["id", "excerpt"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique evidence identifier, e.g. 'ev-001'"
          },
          "email_from": {
            "type": "string",
            "description": "Sender email address"
          },
          "email_to": {
            "type": ["array", "string"],
            "description": "Recipient(s)"
          },
          "date": {
            "type": "string",
            "description": "Date of the email"
          },
          "subject": {
            "type": "string",
            "description": "Subject line"
          },
          "excerpt": {
            "type": "string",
            "minLength": 10,
            "description": "Relevant excerpt or paraphrase from the email"
          },
          "relevance": {
            "type": "string",
            "description": "Why this evidence is relevant"
          },
          "file_path": {
            "type": "string",
            "description": "Path in the Enron dataset, if known"
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 5,
      "description": "At least 5 timeline events spanning the Enron arc.",
      "items": {
        "type": "object",
        "required": ["date", "event"],
        "properties": {
          "date": {
            "type": "string",
            "description": "Date or approximate date"
          },
          "event": {
            "type": "string",
            "minLength": 10,
            "description": "Description of the event"
          },
          "source": {
            "type": "string",
            "description": "Source: corpus_email, corpus_cluster, external_context"
          },
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "description": "People and organizations identified in the investigation.",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Entity name"
          },
          "type": {
            "type": "string",
            "enum": ["person", "organization", "vehicle", "partnership", "government"],
            "description": "Entity type"
          },
          "role": {
            "type": "string",
            "description": "Role at Enron or in the case"
          },
          "email_addresses": {
            "type": "array",
            "items": {"type": "string"}
          },
          "significance": {
            "type": "string",
            "description": "Why this entity matters to the investigation"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "description": "Key risks or red flags identified.",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {"type": "string"},
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "Open questions the investigation could not resolve.",
      "items": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": {"type": "string"},
          "reason": {"type": "string"},
          "what_would_resolve_it": {"type": "string"}
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Recommended follow-up investigation directions.",
      "items": {
        "type": "object",
        "required": ["recommendation"],
        "properties": {
          "recommendation": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "description": "At least 3 limitations of the analysis.",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {"type": "string"},
          "impact": {"type": "string"}
        }
      }
    },
    "context_strategy": {
      "type": "string",
      "description": "Description of the context engineering strategy used"
    },
    "submitted_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of submission"
    }
  },
  "allOf": [
    {
      "description": "Must include investigative-timeline section",
      "properties": {
        "sections": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "const": "investigative-timeline"}
            },
            "required": ["id"]
          }
        }
      }
    },
    {
      "description": "Must include evidence-backed-claims section",
      "properties": {
        "sections": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "const": "evidence-backed-claims"}
            },
            "required": ["id"]
          }
        }
      }
    },
    {
      "description": "Must include ethical-and-evidentiary-limitations section",
      "properties": {
        "sections": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "const": "ethical-and-evidentiary-limitations"}
            },
            "required": ["id"]
          }
        }
      }
    }
  ]
}
