{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-engineering-arena.dev/schemas/score.schema.json",
  "title": "Score",
  "type": "object",
  "required": ["task_id", "participant_id", "overall_score", "scored_by"],
  "properties": {
    "task_id": { "type": "string" },
    "participant_id": { "type": "string" },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "scores": {
      "type": "object",
      "properties": {
        "answer_quality": { "type": "number", "minimum": 0, "maximum": 100 },
        "evidence_quality": { "type": "number", "minimum": 0, "maximum": 100 },
        "context_efficiency": { "type": "number", "minimum": 0, "maximum": 100 },
        "uncertainty_handling": { "type": "number", "minimum": 0, "maximum": 100 },
        "visual_clarity": { "type": "number", "minimum": 0, "maximum": 100 },
        "reproducibility": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "notes": { "type": "string" },
    "scored_by": { "type": "string", "enum": ["manual", "auto", "llm_judge", "hybrid"] },
    "scored_at": { "type": "string", "format": "date" }
  }
}
